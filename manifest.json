{
  "manifest_version": 3,
  "name": "NoScroll Shorts - 最強ドパガキ対策",
  "version": "1.0.0",
  "description": "YouTube Shortsのスクロール、下送りボタン、次の動画を完全消滅。無限スワイプによるドパミン中毒を徹底遮断する最強拡張機能。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NoScroll Shorts 設定",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ]
}

